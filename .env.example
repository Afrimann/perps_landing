# ─────────────────────────────────────────────────────────────────────────
#  Programme applications (src/app/api/apply/route.ts)
#
#  Copy this file to `.env.local` and fill it in. Without all three, the
#  apply form returns a 503 and the applicant is told applications are
#  temporarily unavailable — it never fails silently.
# ─────────────────────────────────────────────────────────────────────────

# From https://resend.com/api-keys — free tier covers 3,000 emails a month.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Where applications are delivered. The foundation's own inbox.
APPLICATIONS_TO_EMAIL=yonwurennajfoundation@gmail.com

# The "from" address. MUST be on a domain verified in Resend — a Gmail
# address will be rejected. Until the foundation's domain is verified,
# Resend's shared sender works for testing:
#   RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_EMAIL=applications@yonwurennajfoundation.org
